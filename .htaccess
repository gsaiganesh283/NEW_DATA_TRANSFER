<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Prevent direct access to php folder files
    RewriteRule ^php/data/ - [F]
    
    # Redirect to php folder if needed
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/ php/index.php [QSA,L]
    RewriteRule ^auth/ php/index.php [QSA,L]
    RewriteRule ^admin/ php/index.php [QSA,L]
</IfModule>

# Set appropriate headers
<FilesMatch "\.(js|css|json|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# Allow access to specific directories
<Directory "uploads">
    Order allow,deny
    Allow from all
</Directory>
