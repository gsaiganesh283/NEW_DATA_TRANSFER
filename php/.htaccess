<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /php/

    # Prevent direct access to folders
    RewriteRule ^(data|uploads)/.*$ - [F]

    # Redirect all requests through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?request=$1 [QSA,L]
</IfModule>

# Set file upload limits for PHP
<IfModule mod_php.c>
    php_value upload_max_filesize 2000M
    php_value post_max_size 2000M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>

# Deny direct access to sensitive files
<FilesMatch "\.(json|sql|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to data directory only for reading
<Directory "data">
    Order allow,deny
    Allow from none
    Deny from all
</Directory>

# Allow access to uploads directory for downloads
<Directory "uploads">
    Order allow,deny
    Allow from all
</Directory>
